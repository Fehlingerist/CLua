{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src", 
    "outDir": "build",
    "types": [],

    "paths": {
      "#root/*": ["./src/*"],
      "#config/*": ["./src/config/*"],
      "#common/*": ["./src/common/*"],
      "#node/*": ["./node_modules/*"]
    },

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  
  "include": [
    "src/**/*",
    "node_modules/**/*"
  ]
}
